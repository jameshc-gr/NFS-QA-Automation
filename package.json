{
  "name": "webautomation",
  "version": "1.0.0",
  "description": "Playwright automation framework with web, API, and AI-assisted test generation layers",
  "main": "index.js",
  "scripts": {
    "test": "npx playwright test",
    "test:api": "playwright test --project=api-tests",
    "test:api:headed": "playwright test --project=api-tests --headed",
    "test:api:report": "playwright show-report",
    "validate:api-mapping": "ts-node scripts/validate-api-mapping.ts --environment=qa",
    "validate:api-mapping:prod": "ts-node scripts/validate-api-mapping.ts --environment=prod",
    "test:api-integration": "TEST_PROJECT=student-IDR npx playwright test tests/projects/student-IDR/api-ui-verify.spec.ts",
    "test:api-integration:headed": "TEST_PROJECT=student-IDR npx playwright test tests/projects/student-IDR/api-ui-verify.spec.ts --headed",
    "test:all-api": "npm run validate:api-mapping && npm run test:api-integration",
    "test:api:smoke": "ts-node scripts/run-api-tests.ts --scenario=smoke --environment=qa",
    "test:api:contract": "ts-node scripts/run-api-tests.ts --scenario=contract --environment=qa",
    "test:api:integration": "ts-node scripts/run-api-tests.ts --scenario=integration --environment=qa",
    "test:api:performance": "ts-node scripts/run-api-tests.ts --scenario=performance --environment=qa",
    "test:api:all-scenarios": "npm run test:api:smoke && npm run test:api:contract && npm run test:api:integration",
    "test:api:by-tags": "ts-node scripts/run-api-tests.ts --tags=critical --environment=qa",
    "postman:convert": "ts-node scripts/convert-postman-to-mapping.ts",
    "postman:extract-env": "ts-node scripts/extract-postman-environment.ts --env=qa",
    "postman:extract-env:prod": "ts-node scripts/extract-postman-environment.ts --env=prod",
    "postman:setup": "npm run postman:convert && npm run postman:extract-env",
    "postman:runner": "ts-node scripts/postman-runner.ts",
    "postman:runner:smoke": "ts-node scripts/postman-runner.ts --scenario=smoke",
    "postman:runner:contract": "ts-node scripts/postman-runner.ts --scenario=contract",
    "postman:runner:tags": "ts-node scripts/postman-runner.ts --tags=critical",
    "test:web": "TEST_PROJECT=student-loan-refi npx playwright test tests/projects/student-loan-refi",
    "test:web:cross-browser": "TEST_PROJECT=student-loan-refi npx playwright test tests/projects/student-loan-refi --project=chromium --project=firefox --project=webkit",
    "test:mobile:android": "wdio run mobile/wdio.conf.ts --spec tests/android/**/*.spec.ts",
    "test:mobile:android:create-account": "MOBILE_GV_AUTO_SETUP=true npm run verify:sessions && MOBILE_SPECS=tests/android/create-user.spec.ts wdio run mobile/wdio.conf.ts",
    "test:mobile:android:create-account:qa-firebase": "MOBILE_ANDROID_BUILD=qa-firebase npm run test:mobile:android:create-account",
    "test:mobile:android:create-account:stage-firebase": "MOBILE_ANDROID_BUILD=stage-firebase npm run test:mobile:android:create-account",
    "test:mobile:android:create-account:prod-firebase": "MOBILE_ANDROID_BUILD=prod-firebase npm run test:mobile:android:create-account",
    "build:mobile:android": "MOBILE_PLATFORM=android ts-node scripts/fetch-android-app.ts",
    "encrypt:config": "ts-node scripts/encrypt-config.ts",
    "encrypt:jira-env": "ts-node scripts/encrypt-jira-env.ts",
    "test:mobile:unit": "mocha --node-option no-experimental-strip-types --require ts-node/register/transpile-only --extension ts mobile/tests/verification.spec.ts mobile/tests/crypto.spec.ts",
    "verify:sessions": "ts-node scripts/verify-sessions.ts",
    "setup:gv-session": "ts-node scripts/setup-gv-session.ts",
    "setup:outlook-session": "ts-node scripts/setup-outlook-session.ts",
    "verify:gv-session": "ts-node scripts/verify-gv-session.ts",
    "verify:firebase-access": "ts-node scripts/check-firebase-access.ts",
    "download:firebase-build": "ts-node scripts/download-firebase-build.ts",
    "test:mobile:android:create-user": "MOBILE_PLATFORM=android MOBILE_ENV=prod MOBILE_ANDROID_BUILD=prod MOBILE_SPECS=tests/android/create-user.spec.ts wdio run mobile/wdio.conf.ts",
    "test:mobile:android:create-user:qa": "MOBILE_PLATFORM=android MOBILE_ENV=qa MOBILE_ANDROID_BUILD=qa MOBILE_SPECS=tests/android/create-user.spec.ts wdio run mobile/wdio.conf.ts",
    "test:mobile:ios:create-user": "MOBILE_PLATFORM=ios MOBILE_ENV=prod MOBILE_SPECS=tests/ios/create-user.spec.ts wdio run mobile/wdio.conf.ts",
    "test:mobile:ios": "wdio run mobile/wdio.conf.ts",
    "test:mobile:ios:simulator": "MOBILE_PLATFORM=ios wdio run mobile/wdio.conf.ts",
    "test:mobile:ios:create-account": "MOBILE_PLATFORM=ios MOBILE_SPECS=tests/ios/create-account-verification.spec.ts wdio run mobile/wdio.conf.ts",
    "test:mobile:ios:create-account:qa-xcode": "MOBILE_IOS_BUILD=qa-xcode npm run test:mobile:ios:create-account",
    "test:mobile:ios:create-account:stage-xcode": "MOBILE_IOS_BUILD=stage-xcode npm run test:mobile:ios:create-account",
    "test:mobile:ios:create-account:prod-xcode": "MOBILE_IOS_BUILD=prod-xcode npm run test:mobile:ios:create-account",
    "build:mobile:ios": "MOBILE_PLATFORM=ios ts-node scripts/build-ios-app.ts",
    "download:ios:stage-ipa": "ts-node scripts/download-ios-stage-ipa.ts",
    "test:mobile:ios:create-account:qa-ipa": "MOBILE_IOS_BUILD=qa-ipa npm run test:mobile:ios:create-account",
    "test:mobile:ios:create-account:stage-ipa": "MOBILE_IOS_BUILD=stage-ipa npm run test:mobile:ios:create-account",
    "test:mobile:ios:create-account:qa-testflight": "MOBILE_IOS_BUILD=qa-testflight npm run test:mobile:ios:create-account",
    "test:mobile:ios:create-account:stage-testflight": "MOBILE_IOS_BUILD=stage-testflight npm run test:mobile:ios:create-account",
    "test:eligible": "TEST_PROJECT=student-loan-refi npx playwright test tests/projects/student-loan-refi/LK[0-9]*.spec.ts",
    "test:decline": "TEST_PROJECT=student-loan-refi npx playwright test tests/projects/student-loan-refi/LK_CD*.spec.ts",
    "test:nocredit": "TEST_PROJECT=student-loan-refi npx playwright test tests/projects/student-loan-refi/LK_NC*.spec.ts",
    "test:ineligible": "TEST_PROJECT=student-loan-refi npx playwright test tests/projects/student-loan-refi/LK_IN*.spec.ts",
    "test:project:student-loan-refi": "TEST_PROJECT=student-loan-refi npx playwright test tests/projects/student-loan-refi",
    "test:project:student-IDR": "TEST_PROJECT=student-IDR npx playwright test tests/projects/student-IDR",
    "typecheck": "tsc --noEmit",
    "typecheck:mobile": "tsc -p mobile/tsconfig.json --noEmit",
    "generate:test": "node scripts/generate-test.js",
    "organize-reports": "node scripts/organize-reports.js",
    "posttest": "npm run organize-reports"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@playwright/test": "^1.61.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "^25.9.3",
    "@wdio/appium-service": "^9.10.0",
    "@wdio/cli": "^9.10.0",
    "@wdio/local-runner": "^9.10.0",
    "@wdio/mocha-framework": "^9.10.0",
    "@wdio/spec-reporter": "^9.10.0",
    "@wdio/types": "^9.10.0",
    "ajv": "^8.20.0",
    "appium": "^3.1.0",
    "appium-uiautomator2-driver": "^8.0.0",
    "appium-xcuitest-driver": "^11.16.3",
    "dotenv": "^17.4.2",
    "imap-simple": "^5.1.0",
    "node-fetch": "^2.7.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "webdriverio": "^9.10.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.57.0",
    "easy-yopmail": "5.2.2",
    "langchain": "^1.5.2",
    "yaml": "^2.8.1",
    "zod": "^3.25.76"
  }
}
