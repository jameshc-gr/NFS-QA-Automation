# Existing .gitignore content preserved. Adding test-results and ai/memory
test-results/
ai/memory/
temp/
# End additions

# Playwright
node_modules/
/test-results/
test-results/
# Legacy Allure output. allure-playwright defaults to a loose `./allure-results` in the
# repo root when `resultsDir` is not set; all results belong under `/test-results/allure/`.
# Kept ignored as a safety net; see playwright.config.ts (allure-playwright `resultsDir`).
/allure-results/
# Locally generated Allure HTML report (see docs/reporting.md).
/allure-report/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Local Playwright MCP snapshots and logs
.playwright-mcp/

# Environment variables (contains sensitive test data)
.env
.env.local
.env.development
.env.test
.env.qa

# Local simulator bundles and macOS metadata
.DS_Store
test-data/mobile-app/gri/ios/*.app/
# Versioned build artifacts (test-data/mobile-app/gri/ios/<version>/<env>/), but
# keep build-info.json so the tested build stays identifiable.
test-data/mobile-app/gri/ios/*/*/*.app/
test-data/mobile-app/gri/ios/*/*/*.ipa
test-data/mobile-app/gri/android/*.apk
test-data/mobile-app/gri/android/*/*/*.apk
test-data/mobile-app/gri/android/*/*/*.aab
# Firebase build artifacts (not extracted, just the raw downloads)
test-data/mobile-app/gri/android/firebase/*.apk
test-data/mobile-app/gri/android/firebase/*.aab

# Service account keys for Firebase App Distribution downloads
*-service-account.json

# Saved browser sessions for verification-code retrieval (Google Voice / Outlook+Okta)
mobile/.auth/
mobile/.builds/

# Local Solution Finder loan extraction artifacts
test-data/solution-finder/*
!test-data/solution-finder/dashboard-auth.yml

# Local DMX dashboard templates, run configuration, and credential-bearing results
test-data/DMX/dmx-dashboard-*.json
