# Existing .gitignore content preserved. Adding test-results and ai/memory
test-results/
ai/memory/
temp/
# End additions

# Playwright
node_modules/
/test-results/
test-results/
# Generated output at any suite depth; reusable test-data inputs stay trackable.
allure-results/
allure-report/
playwright-report/
blob-report/
# Legacy Allure output. allure-playwright defaults to a loose `./allure-results` in the
# repo root when `resultsDir` is not set; all results belong under `/test-results/allure/`.
# Kept ignored as a safety net; see playwright.config.ts (allure-playwright `resultsDir`).
/allure-results/
# Locally generated Allure HTML report (see docs/reporting.md).
/allure-report/
/playwright-report/
/blob-report/
/playwright/.cache/
/playwright/.auth/

# Local Playwright MCP snapshots and logs
.playwright-mcp/
# Local Firebase CLI diagnostics must not be committed.
firebase-debug*.log

# Environment variables (contains sensitive test data)
.env
.env.local
.env.development
.env.test
.env.qa

# Local simulator bundles and macOS metadata
.DS_Store
test-data/mobile-app/gri/ios/*.app/
# Versioned build artifacts (test-data/mobile-app/gri/ios/<version>/<env>/), but
# keep build-info.json so the tested build stays identifiable.
test-data/mobile-app/gri/ios/*/*/*.app/
test-data/mobile-app/gri/ios/*/*/*.ipa
test-data/mobile-app/gri/android/*.apk
test-data/mobile-app/gri/android/*/*/*.apk
test-data/mobile-app/gri/android/*/*/*.aab
# Firebase build artifacts (not extracted, just the raw downloads)
test-data/mobile-app/gri/android/firebase/*.apk
test-data/mobile-app/gri/android/firebase/*.aab

# Service account keys for Firebase App Distribution downloads
*-service-account.json

# Saved browser sessions for verification-code retrieval (Google Voice / Outlook+Okta)
mobile/.auth/
mobile/.builds/

# Local Solution Finder loan extraction artifacts
test-data/solution-finder/*
!test-data/solution-finder/dashboard-auth.yml
!test-data/solution-finder/workbook-scenarios/
!test-data/solution-finder/workbook-scenarios/*.json
# Ad hoc lab inputs may contain borrower data; review explicitly before sharing.
test-data/solution-finder/workbook-scenarios/lab-templates/

# Local DMX dashboard templates, run configuration, and credential-bearing results
test-data/DMX/dmx-dashboard-*.json

# Local run state and generated evidence (shared rules for every checkout).
# Ignore rules do not untrack existing files or redirect output writers.
/auth.json
/test-data/rate-wealth/rate-wealth-auth.json
.current-build
*.log
*.tsbuildinfo
coverage/
.nyc_output/
.cache/
.npm/

# Legacy captures only; do not blanket-ignore fixture images or application assets.
/rate-wealth-yopmail-inbox-form.png
/temp/simulator-screenshot*.png
/test-data/rate-wealth/profile-builder-*.png
/test-data/rate-wealth/rate-wealth-*.png
/test-data/rate-wealth/RW-BUG-*-capture-*.txt
/test-data/mobile-app/gri/reference/*/qa-current-*.png
/test-data/mobile-app/gri/reference/*/qa-current-*.xml
/test-data/mobile-app/gri/reference/*/qa-current-*-capture-manifest.json
/test-data/mobile-app/gri/reference/*/localization-report-summary.txt
