{
    "chat.tools.terminal.autoApprove": {
        "/^node <<'NODE'\nconst fs = require\\('node:fs'\\);\nconst assert = require\\('node:assert/strict'\\);\nconst yaml = require\\('yaml'\\);\nconst root = '\\.github/agents';\nconst profiles = fs\\.readdirSync\\(root\\)\\.filter\\(f => f\\.endsWith\\('\\.agent\\.md'\\)\\);\nconst metadata = file => \\{\n  const text = fs\\.readFileSync\\(file, 'utf8'\\);\n  const match = text\\.match\\(/\\^---\\\\n\\(\\[\\\\s\\\\S\\]\\*\\?\\)\\\\n---/\\);\n  assert\\(match, `\\$\\{file\\}: missing frontmatter`\\);\n  const doc = yaml\\.parseDocument\\(match\\[1\\]\\);\n  assert\\.equal\\(doc\\.errors\\.length, 0, `\\$\\{file\\}: invalid YAML`\\);\n  assert\\(doc\\.toJS\\(\\)\\.description, `\\$\\{file\\}: missing description`\\);\n  return doc\\.toJS\\(\\);\n\\};\nfor \\(const file of profiles\\) \\{\n  for \\(const agent of metadata\\(`\\$\\{root\\}/\\$\\{file\\}`\\)\\.agents \\|\\| \\[\\]\\) assert\\(fs\\.existsSync\\(`\\$\\{root\\}/\\$\\{agent\\}\\.agent\\.md`\\), `\\$\\{file\\}: unresolved \\$\\{agent\\}`\\);\n\\}\nfor \\(const suffix of \\['orchestrator', 'planner', 'generator', 'healer'\\]\\) \\{\n  const file = `playwright-test-\\$\\{suffix\\}\\.agent\\.md`;\n  const text = fs\\.readFileSync\\(`\\$\\{root\\}/\\$\\{file\\}`, 'utf8'\\);\n  const mirror = `ai/jobs/agents/playwright_agents/\\$\\{file\\}`;\n  metadata\\(mirror\\);\n  assert\\.equal\\(text, fs\\.readFileSync\\(mirror, 'utf8'\\), `\\$\\{file\\}: mirror drift`\\);\n  assert\\(text\\.includes\\('ai/team-agent/README\\.md'\\), `\\$\\{file\\}: missing contract`\\);\n  if \\(suffix !== 'orchestrator'\\) assert\\(metadata\\(`\\$\\{root\\}/\\$\\{file\\}`\\)\\.tools\\.includes\\('read'\\)\\);\n\\}\nassert\\(metadata\\(`\\$\\{root\\}/team-pm\\.agent\\.md`\\)\\.agents\\.includes\\('playwright-test-orchestrator'\\)\\);\nfor \\(const file of fs\\.readdirSync\\('ai/team-agent/roles'\\)\\) \\{\n  const text = fs\\.readFileSync\\(`ai/team-agent/roles/\\$\\{file\\}`, 'utf8'\\)\\.replace\\(/\\\\s\\+/g, ' '\\);\n  assert\\(/shared \\(\\?:coordination \\)\\?contract/\\.test\\(text\\), `\\$\\{file\\}: missing coordination rule`\\);\n\\}\nfor \\(const file of profiles\\.filter\\(f => f\\.startsWith\\('team-'\\)\\)\\) \\{\n  for \\(const ref of fs\\.readFileSync\\(`\\$\\{root\\}/\\$\\{file\\}`, 'utf8'\\)\\.matchAll\\(/`\\(ai\\\\/team-agent\\\\/\\[\\^`\\]\\+\\\\\\.md\\)`/g\\)\\) assert\\(fs\\.existsSync\\(ref\\[1\\]\\), `\\$\\{file\\}: missing \\$\\{ref\\[1\\]\\}`\\);\n\\}\nmetadata\\('ai/jobs/skills/playwright-framework-context/SKILL\\.md'\\);\nconsole\\.log\\(`PASS: \\$\\{profiles\\.length\\} agent profiles \\+ 4 mirrors \\+ framework skill YAML; all delegation targets and team references resolve; mirrors match; all 7 roles wired\\.`\\);\nNODE$/": {
            "approve": true,
            "matchCommandLine": true
        }
